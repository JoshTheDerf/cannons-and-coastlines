# Headers for the static assets served by the Worker.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# build.sh copies this file into nuxt-site/public/ so `nuxt build` emits it
# into .output/public/, which wrangler.jsonc serves as the assets directory.
# Only static assets go through here: SSR'd HTML comes from the Worker, so
# headers for pages belong in nuxt-site/nuxt.config.ts routeRules instead.
#
# Note: Cache-Control from multiple matching rules is combined (not
# overridden), so we keep Cache-Control out of the catch-all /* block and
# only set it on specific paths.

# Long cache for stable static assets (filenames don't change)
/assets/photos/*
    Cache-Control: public, max-age=31536000, immutable

/assets/images/*
    Cache-Control: public, max-age=31536000, immutable

/assets/ships/*
    Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
    Cache-Control: public, max-age=31536000, immutable

# The base-set zip keeps one URL across releases (its filename carries no
# version), so browsers and the CDN must check back for a new copy. The
# ETag makes an unchanged file a cheap 304.
/assets/stls/*
    Cache-Control: public, max-age=0, must-revalidate

# 3D preview meshes are rebuilt in place when a model changes.
/assets/previews/*
    Cache-Control: public, max-age=3600, must-revalidate

# The /game/ files keep fixed names. index.html is revalidated on every load
# and its script/style URLs carry ?v=<hash> (build.sh), so a deploy never
# serves a mix of old and new files.
/game/*
    Cache-Control: public, no-cache

# Rulebook PDFs — moderate cache, files rotate occasionally
/rulebook/*
    Cache-Control: public, max-age=3600, must-revalidate

# Security headers everywhere (no Cache-Control here on purpose,
# so it doesn't get concatenated with the rules above).
/*
    X-Content-Type-Options: nosniff
    X-Frame-Options: SAMEORIGIN
    Referrer-Policy: strict-origin-when-cross-origin
    Strict-Transport-Security: max-age=31536000; includeSubDomains
    Permissions-Policy: interest-cohort=()
