# Local-only material and editor/tool state
_internal*
.claude

# Build output. (gitignore has no inline comments, hence the comment lines.)
# jake/OrcaSlicer scratch (3MFs, etc.)
build/
# per-page SVGs, regenerated by `jake rulebook`
rulebook/svg/
__pycache__/
node_modules/
# Blender autosaves alongside scripts/blender/assemblies/*.blend
*.blend1
# OrcaSlicer CLI status dump, written into the working directory
result.json

# Sub-project build output is ignored by that project's own .gitignore:
#   nuxt-site/.gitignore        .output/ .nuxt/ .data/ dist/ and the
#                               public/_headers + public/_redirects copies
#                               that build.sh stages there
#   tools/bitty-cad/.gitignore  dist/

# ── Paid (non-base-game) STL payloads ─────────────────────────────────
# These sets are sold, not free. The binaries must never enter git
# history: once committed they are recoverable from every clone forever,
# even after a later `git rm`. The local folders are the staging area you
# drop files into; scripts/publish-paid-sets.sh pushes them to R2, which
# is the only place they are served from.
#
# Listed explicitly, one line per paid set, rather than a `*-set/` glob:
# a glob would also swallow base-set/ (free, and tracked) and would
# silently hide any future free set someone adds. When a new paid set is
# created, add its line here in the same commit as its set.json.
#
# Only payloads are ignored. Each set.json manifest IS tracked: it carries
# the release flag, price, and image wiring, and holds nothing sellable.
assets/stls/industry-set/**
assets/stls/islander-set/**
assets/stls/shadow-fleet-set/**
assets/stls/sun-fleet-set/**
assets/stls/treasure-fleet-set/**
!assets/stls/*/set.json
